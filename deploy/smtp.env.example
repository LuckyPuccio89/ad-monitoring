# Esempio di configurazione SMTP per gli alert Grafana.
# Copiare in /etc/ad-monitoring/smtp.env con permessi 0600 root:root.
# Non committare mai il file reale: contiene la password.
SMTP_HOST=smtp.example.com:587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=cambiami
SMTP_FROM=alerts@example.com
SMTP_FROM_NAME=AD Monitor homelab
SMTP_STARTTLS=MandatoryStartTLS
ALERT_EMAIL=destinatario@example.com

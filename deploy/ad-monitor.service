[Unit]
Description=Active Directory metrics exporter (Samba AD DC)
Documentation=file:///opt/ad-monitoring/docs/RUNBOOK.md
After=network-online.target samba-ad-dc.service docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/ad-monitoring/ad-monitor.py --bind 172.19.0.1 --port 9182
Restart=always
RestartSec=5
User=root
Group=root

# Hardening: il collector legge sam.ldb e i log, non scrive nulla su AD.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadOnlyPaths=/var/log/samba /etc/samba
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ad-monitor

[Install]
WantedBy=multi-user.target
